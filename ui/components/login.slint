import {
    MaterialTypography,
    MaterialPalette,
    MaterialText,
    IconButton,
    FilledIconButton,
    MenuItem,
    TextButton,
    CircularProgressIndicator,
} from "@material";
import { PasswordField } from "password_field.slint";
import { UserSelector } from "user_selector.slint";
import { Icons } from "../../material-1.1.0/ui/icons/icons.slint";
import { AppStyle } from "../style.slint";

export struct User {
    user_name: string,
    real_name: string,
    initials: string,
    avatar: image,
}

export { MenuItem }

export component Login {
    in property <[User]> users;
    in property <[MenuItem]> user-menu-items;
    in-out property <int> selected-user-index: -1;
    in property <image> composer-icon;
    in-out property <string> auth-error;
    in property <string> greeting-msg: "Welcome!";
    in property <bool> is-authenticating: false;

    in property <int> input-revision;
    in property <bool> fingerprint-enabled;
    in property <bool> fingerprint-mode;
    in property <bool> auth-prompt-ready;
    in property <bool> password-requested;
    in property <bool> password-stage;
    callback use-password(string);
    callback use-fingerprint(string);
    property <string> current-username: root.manual-user-entry
        ? root.manual-username : (root.selected-user-index >= 0
            ? root.users[root.selected-user-index].user_name : "");
    property <bool> password-visible: !root.fingerprint-mode
        && (!root.fingerprint-enabled || root.auth-prompt-ready
            || root.password-stage);
    // Informational PAM prompts stay quiet until the user asks for help.
    property <string> feedback: root.auth-error != "" ? root.auth-error
        : (root.password-requested && !root.auth-prompt-ready
            ? @tr("Waiting for password prompt")
            : (root.auth-notice-error ? root.auth-notice : root.auth-status));
    callback fingerprint-hint();
    callback return-to-clock();
    in property <bool> auth-active;
    in property <bool> auth-launching;
    in property <string> auth-status;
    in property <string> auth-notice;
    in property <bool> auth-notice-error;
    in property <string> auth-prompt;
    in property <bool> auth-secret: true;
    callback cancel-auth();
    changed input-revision => { root.password-text = ""; root.show-password = false; }
    callback login(string, string); // user_name, password
    callback user-selected(int);

    property <bool> manual-user-entry: false;
    property <bool> show-password: false;
    property <string> manual-username: "";
    property <string> confirmed-username: "";
    property <int> password-focus-revision: 0;
    property <string> password-text: "";
    property <float> field-opacity: AppStyle.window-opacity * 0.7;

    // Clear error when password or user changes
    changed password-text => {
        root.auth-error = "";
    }
    changed selected-user-index => {
        root.password-focus-revision += 1;
        root.auth-error = "";
        root.password-text = "";
    }
    changed manual-username => {
        if (root.manual-username != root.confirmed-username) {
            root.cancel-auth();
        }
    }
    changed manual-user-entry => {
        root.confirmed-username = "";
        root.cancel-auth();
        root.password-text = "";
        root.auth-error = "";
    }

    width: 100%;
    height: 100%;

    // Content (Centered)
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        alignment: start;
        padding-top: 24px;
        padding-bottom: 32px;

        Rectangle {
            height: 40px;
            if (root.greeting-msg != ""): MaterialText {
                text: root.greeting-msg;
                style: MaterialTypography.headline-medium;
                color: MaterialPalette.primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Avatar
        HorizontalLayout {
            height: 100px;
            alignment: center;
            Rectangle {
                width: 100px;
                height: 100px;
                border_radius: 50px;
                background: MaterialPalette.primary-container;
                clip: true;

                if (!root.manual-user-entry && root.selected-user-index >= 0 && root.users[root.selected-user-index].avatar.width > 0): Image {
                    source: root.users[root.selected-user-index].avatar;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }

                if (!root.manual-user-entry && root.selected-user-index >= 0 && root.users[root.selected-user-index].avatar.width == 0 && root.users[root.selected-user-index].initials != ""): MaterialText {
                    text: root.users[root.selected-user-index].initials;
                    style: MaterialTypography.display-small;
                    color: MaterialPalette.on-primary-container;
                    vertical_alignment: center;
                    horizontal_alignment: center;
                }

                if (root.manual-user-entry || root.selected-user-index < 0 || (root.users[root.selected-user-index].avatar.width == 0 && root.users[root.selected-user-index].initials == "")): Image {
                    source: @image-url("../icons/account_circle.svg");
                    width: 80%;
                    height: 80%;
                    colorize: MaterialPalette.on-primary-container;
                }
            }
        }

        // User Entry Block
        VerticalLayout {
            height: 64px;
            spacing: 0;
            alignment: center;

            if (!root.manual-user-entry): HorizontalLayout {
                alignment: center;
                UserSelector {
                    width: 300px;
                    label: @tr("User");
                    items: root.user-menu-items;
                    current_index <=> root.selected-user-index;
                    leading_icon: @image-url("../icons/person.svg");
                    enabled: !root.auth-launching;
                    background_opacity: root.field-opacity;

                    selected(idx) => {
                        root.user-selected(idx);
                    }
                }
            }

            if (root.manual-user-entry): HorizontalLayout {
                alignment: center;
                PasswordField {
                    width: 300px;
                    label: @tr("Username");
                    auto-focus: true;
                    text <=> root.manual-username;
                    leading_icon: @image-url("../icons/person.svg");
                    enabled: !root.auth-launching;
                    background_opacity: root.field-opacity;
                    key_pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.return-to-clock();
                            return accept;
                        }
                        reject
                    }
                    accepted => {
                        root.confirmed-username = root.manual-username;
                        if (root.fingerprint-enabled && !root.password-stage) {
                            root.use-fingerprint(root.current-username);
                        } else {
                            root.use-password(root.current-username);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 144px;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                // Only reserve a field slot when a password can be entered.
                if (root.password-visible): Rectangle {
                    height: root.auth-error != "" ? 96px : 56px;
                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        alignment: start;
                        if (root.password-visible): password_input := PasswordField {
                            vertical-stretch: 0;
                            width: 300px;
                            label: root.auth-prompt != "" ? root.auth-prompt : @tr("Password");
                            text <=> root.password-text;
                            auto-focus: root.current-username != ""
                                && (!root.manual-user-entry
                                    || root.manual-username == root.confirmed-username);
                            focus-revision: root.password-focus-revision;
                            input_type: (root.show-password || (root.auth-prompt != "" && !root.auth-secret)) ? InputType.text : InputType.password;
                            has_error: root.auth-error != "";
                            supporting_text: root.auth-error;
                            leading_icon: @image-url("../icons/passkey.svg");
                            trailing_icon: root.show-password ? @image-url("../icons/visibility.svg") : @image-url("../icons/visibility_lock.svg");
                            enabled: !root.is-authenticating;
                            background_opacity: root.field-opacity;

                            key_pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.return-to-clock();
                                    return accept;
                                }
                                reject
                            }
                            trailing_icon_clicked => {
                                root.show-password = !root.show-password;
                            }

                            accepted => {
                                root.login(root.current-username, self.text);
                            }
                        }
                    }
                }

                // One action row shared by both card modes.
                HorizontalLayout {
                    height: 40px;
                    padding-left: 40px;
                    padding-right: 40px;
                    spacing: 0;
                    if (root.fingerprint-enabled &&
                        (!root.password-stage || root.fingerprint-mode)): TextButton {
                        text: root.fingerprint-mode || !root.auth-prompt-ready
                            ? @tr("Use password") : @tr("Use fingerprint");
                        enabled: !root.auth-launching
                            && !(root.password-requested && !root.auth-prompt-ready);
                        clicked => {
                            if (root.fingerprint-mode || !root.auth-prompt-ready) {
                                root.use-password(root.current-username);
                            } else {
                                root.use-fingerprint(root.current-username);
                                root.fingerprint-hint();
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TextButton {
                        text: root.manual-user-entry ? @tr("Select from list") : @tr("Not listed?");
                        enabled: !root.is-authenticating;
                        clicked => { root.manual-user-entry = !root.manual-user-entry; }
                    }
                }

                if (!root.password-visible): Rectangle {
                    height: 96px;
                    MaterialText {
                        x: 40px;
                        width: parent.width - 80px;
                        height: parent.height;
                        text: root.feedback;
                        color: root.auth-error != "" || root.auth-notice-error
                            ? MaterialPalette.error : MaterialPalette.on-surface;
                        style: MaterialTypography.body-small;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }

                if (root.password-visible && root.password-requested
                    && !root.auth-prompt-ready): MaterialText {
                    height: 32px;
                    text: @tr("Waiting for password prompt");
                    style: MaterialTypography.body-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

            }
        }

        // Fixed final slot: the two primary controls always share a position.
        HorizontalLayout {
            height: 64px;
            alignment: center;
            Rectangle {
                width: 64px;
                height: 64px;

                if (!root.is-authenticating): FilledIconButton {
                    icon: root.fingerprint-mode
                        ? @image-url("../icons/fingerprint.svg")
                        : @image-url("../icons/login.svg");
                    width: 100%;
                    height: 100%;

                    clicked => {
                        if (root.fingerprint-mode) {
                            if (root.auth-active) {
                                root.fingerprint-hint();
                            } else {
                                root.use-fingerprint(root.current-username);
                                root.fingerprint-hint();
                            }
                        } else if (root.auth-prompt-ready || root.password-stage
                            || !root.fingerprint-enabled) {
                            root.login(root.current-username, root.password-text);
                        } else {
                            root.use-password(root.current-username);
                        }
                    }
                }

                if (root.is-authenticating): HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        CircularProgressIndicator {
                            width: 48px;
                            height: 48px;
                            indeterminate: true;
                        }
                    }
                }
            }
        }
    }
}
