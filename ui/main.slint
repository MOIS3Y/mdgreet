import {
    MaterialWindow,
    MaterialTypography,
    MaterialText,
    MaterialPalette,
    FloatingActionButton,
    PopupMenu,
    MenuItem,
    IconButton,
    MaterialWindowAdapter,
    SnackBar,
} from "@material";
import { Palette } from "std-widgets.slint";
import { Clock } from "components/clock.slint";
import { Login, User } from "components/login.slint";
import { SessionSelector } from "components/session_selector.slint";
import { PowerBottomSheet } from "components/power_menu.slint";
import { Background } from "components/background.slint";
import { AppStyle } from "style.slint";

import "./fonts/FlexRounded-R.ttf";
import "./fonts/FlexRounded-M.ttf";
import "./fonts/FlexRounded-B.ttf";
import "./fonts/MaterialDesignIcons.ttf";

export struct Compositor {
    name: string,
    exec: string,
}

export { MaterialPalette, MaterialTypography, User, MenuItem, AppStyle }

export struct UserData {
    user_name: string,
    real_name: string,
    password: string,
}

export component GreeterWindow inherits MaterialWindow {
    default-font-family: AppStyle.default-font-family != "" ? AppStyle.default-font-family : "sans-serif";

    in property <image> background-original;
    in property <image> background-blurred;
    in property <color> background-fallback-color;
    in property <string> hours: "00";
    in property <string> minutes: "00";
    in property <string> date: "";
    in property <string> greeting-msg: "Welcome!";

    in property <[User]> users;
    in property <[MenuItem]> user-menu-items;
    in property <image> composer-icon;
    in-out property <int> selected-user-index: -1;
    in-out property <string> auth-error;

    in property <[Compositor]> compositors;
    in property <[MenuItem]> compositor-menu-items;
    in-out property <int> selected-compositor-index: 0;

    in-out property <bool> is-authenticating: false;
    in-out property <bool> show-login: false;

    // Exported statically compiled icons for Rust backend
    out property <image> default-user-icon: @image-url("icons/person.svg");
    out property <image> default-session-icon: @image-url("icons/auto_awesome_mosaic.svg");

    in-out property <string> system-error-text: "";

    public function show_system_error(err: string) {
        root.system-error-text = err;
        system_error_snack.show();
    }

    callback set-color-scheme(bool);
    set-color-scheme(is-dark) => {
        Palette.color-scheme = is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    in property <bool> fingerprint-enabled: false;
    in property <bool> fingerprint-auto-start: true;
    in-out property <bool> fingerprint-mode: false;
    in-out property <bool> auth-prompt-ready: false;
    in-out property <bool> password-requested: false;
    in-out property <bool> password-stage: false;
    callback use-password(string);
    callback use-fingerprint(string);
    callback fingerprint-hint();
    callback return-to-clock();
    return-to-clock => {
        if (!root.auth-launching) {
            root.show-login = false;
            fs.focus();
        }
    }
    in-out property <bool> auth-launching: false;
    in-out property <bool> auth-active: false;
    in-out property <int> auth-generation: 0;
    in-out property <string> auth-status;
    in-out property <string> auth-notice;
    in-out property <bool> auth-notice-error;
    in-out property <string> auth-prompt;
    in-out property <bool> auth-secret: true;
    callback auth-begin(string, string, bool);
    callback cancel-auth();
    callback clear-auth-input();
    in-out property <int> input-revision: 0;
    clear-auth-input => { root.input-revision += 1; }
    callback auth-context-changed();
    auth-context-changed => {
        if (root.auth-launching) { return; }
        root.cancel-auth();
        root.fingerprint-mode = root.fingerprint-enabled && !root.password-stage;
        root.auto-auth-generation = root.auth-generation;
        auto-auth.start();
    }
    in-out property <int> auto-auth-generation;
    // Coalesce user/session changes into one authentication attempt.
    auto-auth := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            auto-auth.stop();
            if (root.auto-auth-generation == root.auth-generation
                && root.fingerprint-enabled && root.fingerprint-auto-start
                && root.show-login
                && root.selected-user-index >= 0) {
                root.auth-begin(root.users[root.selected-user-index].user_name, "", false);
            }
        }
    }
    changed selected-user-index => {
        root.password-stage = false;
        root.auth-context-changed();
    }
    changed selected-compositor-index => { root.auth-context-changed(); }
    changed show-login => { root.auth-context-changed(); }
    callback login(string, string);
    callback compositor-selected(int);
    callback user-selected(int);

    callback shutdown();
    callback reboot();
    callback sleep();
    callback hibernate();

    // Background Layer
    Background {
        original: root.background-original;
        blurred: root.background-blurred;
        fallback-color: root.background-fallback-color;
        show-login: root.show-login;
    }

    // Interaction Area
    TouchArea {
        clicked => {
            if (!root.show-login) {
                root.show-login = true;
            }
        }

        // Centered Content
        if (!root.show-login): Clock {
            hours: root.hours;
            minutes: root.minutes;
            date: root.date;
        }

        // Bottom Message (Unlock)
        if (!root.show-login): VerticalLayout {
            alignment: end;
            padding-bottom: 60px;

            MaterialText {
                text: @tr("Press any key to unlock");
                style: MaterialTypography.body-large;
                color: MaterialPalette.on-background.with-alpha(0.5);
                horizontal-alignment: center;
            }
        }

        // Login Card
        if (root.show-login): Rectangle {
            width: 380px;
            height: min(500px, parent.height - 48px);
            background: MaterialPalette.surface-container.with-alpha(AppStyle.window-opacity);
            border_radius: 32px;

            Login {
                input-revision: root.input-revision;
                fingerprint-enabled: root.fingerprint-enabled;
                fingerprint-mode: root.fingerprint-mode;
                auth-prompt-ready: root.auth-prompt-ready;
                password-requested: root.password-requested;
                password-stage: root.password-stage;
                use-password(user) => { root.use-password(user); }
                use-fingerprint(user) => { root.use-fingerprint(user); }
                auth-active: root.auth-active;
                auth-launching: root.auth-launching;
                auth-status: root.auth-status;
                auth-notice: root.auth-notice;
                auth-notice-error: root.auth-notice-error;
                auth-prompt: root.auth-prompt;
                auth-secret: root.auth-secret;
                cancel-auth => { root.cancel-auth(); }
                fingerprint-hint => { root.fingerprint-hint(); }
                return-to-clock => { root.return-to-clock(); }
                users: root.users;
                user-menu-items: root.user-menu-items;
                selected-user-index <=> root.selected-user-index;
                composer-icon: root.composer-icon;
                auth-error <=> root.auth-error;
                greeting-msg: root.greeting-msg;
                is-authenticating <=> root.is-authenticating;

                login(user_name, pwd) => {
                    root.auth-begin(user_name, pwd, true);
                }

                user-selected(idx) => {
                    root.user-selected(idx);
                }
            }
        }
    }

    // Bottom UI
    if (root.show-login): Rectangle {
        VerticalLayout {
            alignment: end;
            padding-bottom: 24px;
            padding-left: 24px;
            padding-right: 24px;

            Rectangle {
                // Power Menu Trigger
                HorizontalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/settings_power.svg");
                        width: 48px;
                        height: 48px;
                        clicked => {
                            power_menu.show();
                        }
                    }
                }

                // Session Selection
                HorizontalLayout {
                    alignment: end;
                    SessionSelector {
                        items: root.compositor-menu-items;
                        current-name: root.compositors[root.selected-compositor-index].name;
                        icon: @image-url("icons/dashboard_2_gear.svg");
                        selected(idx) => {
                            if (root.auth-launching) { return; }
                            root.selected-compositor-index = idx;
                            root.compositor-selected(idx);
                        }
                    }
                }
            }
        }
    }

    // Power Menu Instance
    power_menu := PowerBottomSheet {
        width: root.width;
        height: root.height;
        background_opacity: AppStyle.window-opacity;

        shutdown => {
            root.shutdown();
        }
        reboot => {
            root.reboot();
        }
        sleep => {
            root.sleep();
        }
        hibernate => {
            root.hibernate();
        }
    }

    // Keyboard Interaction
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(event) => {
            if (!root.show-login) {
                root.show-login = true;
                return accept;
            }
            if (event.text == Key.Escape && !root.auth-launching) {
                root.return-to-clock();
                return accept;
            }
            reject
        }
    }

    system_error_snack := SnackBar {
        width: root.width;
        height: root.height;
        text: root.system-error-text;
        has_close_button: true;
    }
}
